<view class="page {{_theme}}" wx:if="{{house}}">
  <view class="hero">
    <text class="hero__title">{{house.title}}</text>
    <text class="hero__sub">{{house.cityName}}</text>
    <text class="hero__price">¥{{house.priceMin}}-{{house.priceMax}}/{{house.priceUnit}}</text>
  </view>

  <view class="card">
    <view class="tags">
      <text class="tag" wx:for="{{house.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <text class="muted">{{house.desc}}</text>
  </view>

  <view class="card" wx:if="{{house.accessible}}">
    <text class="label">适老设施</text>
    <view class="row">
      <text class="tag" wx:if="{{house.accessible.elevator}}">电梯</text>
      <text class="tag" wx:if="{{house.accessible.ramp}}">无障碍坡道</text>
      <text class="tag" wx:if="{{house.accessible.grabBar}}">扶手</text>
      <text class="tag" wx:if="{{house.accessible.emergencyCall}}">紧急呼叫</text>
    </view>
  </view>

  <view class="actions">
    <view class="btn btn-block" bindtap="onContract">合同体检</view>
  </view>
</view>
