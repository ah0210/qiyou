<view class="page {{_theme}}">
  <view class="filters">
    <view wx:for="{{types}}" wx:key="key"
          class="filter {{type === item.key ? 'filter--on' : ''}}"
          data-type="{{item.key}}" bindtap="onType">{{item.label}}</view>
  </view>
  <view class="card">
    <input class="input" placeholder="搜索政策关键词..." value="{{keyword}}" bindinput="onKeyword" />
  </view>

  <view class="card" wx:for="{{list}}" wx:key="_id">
    <text class="p-title">{{item.title}}</text>
    <text class="muted tag-city">{{item.city}} · {{item.year}}</text>
    <text class="p-content">{{item.content}}</text>
    <text class="source">来源：{{item.source}}</text>
  </view>

  <view class="foot muted">政策内容仅供参考，请以官方最新发布为准</view>
</view>
