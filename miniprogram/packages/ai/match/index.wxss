.label { font-size: var(--fs-md); font-weight: 600; display: block; margin-bottom: var(--sp-sm); }
.input { background: var(--c-bg); border-radius: var(--radius); padding: var(--sp-sm) var(--sp-md); font-size: var(--fs-md); }
.months { display: flex; flex-wrap: wrap; gap: var(--sp-xs); }
.month { padding: var(--sp-xs) var(--sp-md); background: var(--c-bg); border-radius: 999rpx; font-size: var(--fs-sm); }
.month--on { background: var(--c-primary); color: #fff; }
.needs { display: flex; flex-wrap: wrap; gap: var(--sp-xs); }
.need { padding: var(--sp-xs) var(--sp-md); background: var(--c-bg); border-radius: 999rpx; font-size: var(--fs-sm); }
.need--on { background: rgba(47,107,79,0.12); color: var(--c-primary); border: 2rpx solid var(--c-primary); }
.submit { padding: var(--sp-md); }
