.empty { text-align: center; padding: 200rpx 0; color: var(--c-text-sub); }

/* loading */
.loading { text-align: center; padding: 200rpx 0; }
.spin {
  width: 72rpx; height: 72rpx; margin: 0 auto 24rpx;
  border: 6rpx solid var(--c-primary-light);
  border-top-color: var(--c-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: var(--fs-lg); font-weight: 700; color: var(--c-primary); }
.text-sub { color: var(--c-text-sub); font-size: var(--fs-sm); margin-top: 8rpx; }

/* head */
.head { padding: var(--sp-sm) 0 var(--sp-md); }
.head-title { font-size: var(--fs-xl); font-weight: 700; display: flex; align-items: center; }
.head-sub { color: var(--c-text-sub); font-size: var(--fs-sm); margin-top: 8rpx; }

/* 城市方案卡 */
.city-plan { padding: var(--sp-md); }
.rank-row { display: flex; align-items: center; }
.rank {
  font-size: var(--fs-sm); font-weight: 800; color: #fff;
  background: var(--c-primary); border-radius: 10rpx;
  padding: 4rpx 14rpx; margin-right: 16rpx; flex-shrink: 0;
}
.rank.r1 { background: #c8922e; }
.rank.r2 { background: #8a8f99; }
.rank.r3 { background: #b9784a; }
.city-name { font-size: var(--fs-lg); font-weight: 700; }
.prov { font-size: var(--fs-xs); color: var(--c-text-sub); margin-left: 10rpx; }
.score-wrap { text-align: center; margin-left: 12rpx; flex-shrink: 0; }
.score { font-size: var(--fs-xxl); font-weight: 900; color: var(--c-primary); display: block; line-height: 1.1; }
.score-t { font-size: var(--fs-xs); color: var(--c-text-sub); }

.reasons { margin: var(--sp-sm) 0; }
.reason { font-size: var(--fs-sm); color: var(--c-text); padding: 6rpx 0; line-height: 1.6; }

.city-btns { margin-top: var(--sp-sm); }
.btn-block { width: 100%; margin-top: var(--sp-sm); }
.retry { margin-top: var(--sp-sm); }
