.label { font-size: var(--fs-md); font-weight: 600; display: block; margin-bottom: var(--sp-sm); }
.code { font-size: var(--fs-xl); font-weight: 700; letter-spacing: 8rpx; color: var(--c-primary); }
.input { background: var(--c-bg); border-radius: 999rpx; padding: var(--sp-sm) var(--sp-md); font-size: var(--fs-md); }
