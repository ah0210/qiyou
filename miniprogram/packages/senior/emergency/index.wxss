.sos { text-align: center; padding: var(--sp-xl) 0; }
.sos__btn {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: var(--c-danger);
  color: #fff;
  justify-content: center;
}
.sos__icon { font-size: 120rpx; }
.sos__label { font-size: var(--fs-lg); margin-top: var(--sp-sm); }
.label { font-size: var(--fs-md); font-weight: 600; display: block; margin-bottom: var(--sp-sm); }
