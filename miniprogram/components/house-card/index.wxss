.hcard {
  background: var(--c-card, #fff);
  border-radius: var(--radius, 20rpx);
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 40, 33, 0.05);
}
.cover-wrap { position: relative; height: 260rpx; background: var(--c-primary-light, #e6f3ee); }
.theme--elder .cover-wrap { height: 320rpx; }
.cover { width: 100%; height: 100%; background-size: cover; background-position: center; }
.cover-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #d9efe6, #bfe3d3);
  color: #0c5a46; font-size: var(--fs-xxl, 48rpx); font-weight: 800;
}
.type-badge {
  position: absolute; left: 16rpx; top: 16rpx;
  background: rgba(18, 122, 95, 0.88); color: #fff;
  font-size: var(--fs-xs, 22rpx); border-radius: 10rpx; padding: 4rpx 14rpx;
}
.info { padding: 20rpx 24rpx 24rpx; }
.title { font-size: var(--fs-md, 30rpx); font-weight: 700; margin-bottom: 10rpx; }
.tags { margin-bottom: 12rpx; min-height: 44rpx; }
.price { color: var(--c-accent, #f0863b); font-weight: 800; font-size: var(--fs-lg, 34rpx); }
.price .unit { font-size: var(--fs-xs, 22rpx); font-weight: 400; margin-left: 4rpx; color: var(--c-sub, #6b7470); }
.rate { color: var(--c-warn, #d98f1f); font-size: var(--fs-sm, 24rpx); font-weight: 700; }
